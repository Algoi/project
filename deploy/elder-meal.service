[Unit]
Description=Community elderly meal service
After=network.target mysql.service

[Service]
User=eldermeal
Group=eldermeal
WorkingDirectory=/opt/elder-meal
EnvironmentFile=/etc/elder-meal/server.env
ExecStart=/usr/bin/java -jar /opt/elder-meal/server/elder-meal-server-1.0.0.jar --spring.profiles.active=prod --server.address=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/elder-meal
UMask=0077

[Install]
WantedBy=multi-user.target
